# Secrets: never commit your real .env file.
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible API provider
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Local test: set BOT_MODE=polling
# Online webhook deployment: set BOT_MODE=webhook and WEBHOOK_URL=https://your-service.example
BOT_MODE=polling
WEBHOOK_URL=
WEBHOOK_SECRET=

BOT_USERNAME=
SYSTEM_PROMPT_FILE=persona/persona.md
MAX_CONTEXT_MESSAGES=12
PORT=3000
